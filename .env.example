# =============================================================================
# ATTRIBUTER — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.
# NEVER put real secrets in this file.
# =============================================================================


# --- Supabase (Backend / Service Role) ----------------------------------------
# Used ONLY in server-side code (API routes, Server Actions).
# NEVER expose to browser or NEXT_PUBLIC_ variables.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# --- Supabase (Frontend / Anon) -----------------------------------------------
# Safe to expose to the browser — anon key only, enforced by RLS.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# --- Application URLs ---------------------------------------------------------
# Set to your production domain on Vercel.
# Used to generate tracking SDK installation snippets in the dashboard.
# Development: http://localhost:3001
# Production:  https://your-app.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# --- Legacy Express Server (port 3000) ----------------------------------------
# Used by npm run server — the standalone Express ingestion server.
# Can be removed once all ingestion is through Next.js API routes.
PORT=3000

# --- Razorpay (Payments) -------------------------------------------------------
# Use test keys during development. NEVER use production keys in development.
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=your-razorpay-secret-here
# RAZORPAY_WEBHOOK_SECRET=your-webhook-secret-here
# NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx

# --- Email (optional — for transactional emails) ------------------------------
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=noreply@yourdomain.com
# SMTP_PASS=your-smtp-password

# --- Error Monitoring (optional) -----------------------------------------------
# NEXT_PUBLIC_SENTRY_DSN=https://xxx@yyy.ingest.sentry.io/zzz
# SENTRY_AUTH_TOKEN=your-sentry-auth-token

# --- HubSpot CRM Integration ---------------------------------------------------
# IMPORTANT: Sorget requires a modern HubSpot Projects-based Public App.
# Legacy Public Apps and Private App Tokens (pat-...) are NOT compatible.
#
# Setup:
#   1. Install HubSpot CLI: npm install -g @hubspot/cli@latest
#   2. Authenticate:        hs account auth
#   3. Create project:      hs project create --auth oauth
#   4. Deploy:              hs project upload
#   5. Get credentials:     HubSpot Developer Portal → Projects → Auth tab
#
# Redirect URI to register in app-hsmeta.json:
#   Development: http://localhost:3001/api/crm/hubspot/callback
#   Production:  https://your-app.vercel.app/api/crm/hubspot/callback
#
# Required OAuth scopes (configure in app-hsmeta.json):
#   crm.objects.contacts.read
#   crm.objects.contacts.write
#
# The Client ID must be a UUID (e.g. a1b2c3d4-...), NOT a pat-... token.
# NEVER expose HUBSPOT_CLIENT_SECRET to the browser or commit it to Git.
# HUBSPOT_CLIENT_ID=your-hubspot-public-app-client-id
# HUBSPOT_CLIENT_SECRET=your-hubspot-public-app-client-secret

